@page
@model Relaywright.Web.Pages.Settings.RelayModel
@{
    ViewData["Title"] = "Relay Settings";
}

<section class="page">
    <header class="page-header">
        <div class="page-header-copy">
            <p class="page-eyebrow">Settings</p>
            <h1>Relay Settings</h1>
            <p class="page-summary">Configure how devices submit mail, how the listener exposes SMTP, and how accepted messages are relayed to the upstream smart host.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="surface-status">
            <p class="status">@Model.StatusMessage</p>
        </div>
    }

    <form method="post" class="relay-settings">
        <div asp-validation-summary="ModelOnly" class="status error"></div>

        <partial name="_RelayListenerFields" model="Model" />
        <partial name="_RelayUpstreamFields" model="Model" />
        <partial name="_RelayDeliveryRetentionFields" model="Model" />

        <div class="surface-toolbar">
            <div class="toolbar-right">
                <div class="actions compact-actions">
                    <button type="submit">Save Settings</button>
                </div>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <script src="~/js/relay-settings.js" asp-append-version="true" defer></script>
}
