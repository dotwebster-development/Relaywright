@using Relaywright.Web.UI
@using Relaywright.Web.Services.Updates
@inject IUpdateCheckService UpdateCheckService
@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var navState = isAuthenticated ? AppNavigation.Resolve(Context.Request.Path) : null;
    var appVersion = Relaywright.Web.Infrastructure.ApplicationVersion.DisplayVersion;
    var updateStatus = isAuthenticated ? await UpdateCheckService.GetStatusAsync(Context.RequestAborted) : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Relaywright</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/foundation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/setup.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/surfaces.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/data.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/controls.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/status.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/shared-ui.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell @(isAuthenticated ? "is-authenticated" : "is-public")">
        @if (isAuthenticated && navState is not null)
        {
            <div class="app-overlay" data-nav-dismiss></div>
            <aside class="app-rail" id="app-rail" aria-label="Application navigation">
                <div class="rail-brand">
                    <a class="rail-brand-mark" asp-page="/Index" aria-label="Relaywright home">
                        <img src="~/brand/relaywright-mark.svg" alt="" />
                    </a>
                    <div class="rail-brand-copy">
                        <p class="rail-brand-kicker">Relaywright</p>
                        <p class="rail-brand-note">Local forwarding console</p>
                    </div>
                </div>

                <nav class="rail-nav" aria-label="Primary">
                    @foreach (var navSection in navState.Sections)
                    {
                        <a asp-page="@navSection.Page"
                           class="rail-link @(navState.IsSectionActive(navSection) ? "is-active" : null)"
                           aria-current="@(navState.IsSectionActive(navSection) ? "page" : null)">
                            <span class="rail-link-label">@navSection.Label</span>
                            <span class="rail-link-note">@navSection.Description</span>
                        </a>
                    }
                </nav>

                <div class="rail-footer">
                    <p class="rail-version">Relaywright v@(appVersion)</p>
                    @if (updateStatus?.State == UpdateCheckState.UpdateAvailable)
                    {
                        <p class="rail-version-update">
                            @if (!string.IsNullOrWhiteSpace(updateStatus.ReleaseUrl))
                            {
                                <a href="@updateStatus.ReleaseUrl">Update @updateStatus.LatestVersion available</a>
                            }
                            else
                            {
                                <span>Update @updateStatus.LatestVersion available</span>
                            }
                        </p>
                    }
                    <div class="rail-account">
                        <p class="rail-account-label">Signed in</p>
                        <p class="rail-account-user">@User.Identity?.Name</p>
                        <form method="post" asp-page="/Account/Logout" class="rail-account-form">
                            <button type="submit" class="secondary-button">Logout</button>
                        </form>
                    </div>
                </div>
            </aside>
        }

        <div class="workspace">
            @if (isAuthenticated && navState is not null)
            {
                <nav class="section-nav" aria-label="@($"{navState.ActiveSection.Label} pages")">
                    <div class="section-nav-heading">
                        <button type="button" class="nav-toggle" data-nav-toggle aria-controls="app-rail" aria-expanded="false">
                            Menu
                        </button>
                        <div class="section-nav-label">@navState.ActiveSection.Label</div>
                    </div>
                    <div class="section-nav-items">
                        @foreach (var item in navState.ActiveSection.Items)
                        {
                            <a asp-page="@item.Page"
                               class="section-nav-link @(navState.IsItemActive(item) ? "is-active" : null)"
                               aria-current="@(navState.IsItemActive(item) ? "page" : null)">@item.Label</a>
                        }
                    </div>
                    <div class="settings-search" data-settings-search>
                        <input type="search"
                               placeholder="Search settings"
                               aria-label="Search settings"
                               role="combobox"
                               aria-autocomplete="list"
                               aria-controls="settings-search-results"
                               aria-expanded="false"
                               autocomplete="off"
                               data-settings-search-input />
                        <div class="settings-search-results"
                             id="settings-search-results"
                             role="listbox"
                             aria-label="Matching settings"
                             data-settings-search-results
                             hidden>
                            @for (var index = 0; index < navState.SettingsSearchItems.Count; index++)
                            {
                                var item = navState.SettingsSearchItems[index];
                                <a asp-page="@item.Page"
                                   id="settings-search-option-@index"
                                   role="option"
                                   data-settings-search-item
                                   data-settings-search-text="@($"{item.Label} {item.Group} {item.Keywords}")">
                                    <span>@item.Label</span>
                                    <small>@item.Group</small>
                                </a>
                            }
                            <div class="settings-search-empty" data-settings-search-empty hidden>No matching settings</div>
                        </div>
                        <span class="visually-hidden" aria-live="polite" data-settings-search-announcement></span>
                    </div>
                </nav>
            }
            else
            {
                <header class="public-header">
                    <a class="public-brand" asp-page="/Index">
                        <img src="~/brand/relaywright-mark.svg" alt="" />
                        <span>Relaywright</span>
                    </a>
                </header>
            }

            <main class="content">
                <div class="content-inner">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>
    <dialog class="confirmation-dialog" data-confirm-dialog aria-labelledby="confirmation-dialog-title">
        <div class="confirmation-dialog-copy">
            <h2 id="confirmation-dialog-title" data-confirm-dialog-title>Confirm action</h2>
            <p data-confirm-dialog-message></p>
        </div>
        <div class="actions">
            <button type="button" class="secondary-button" data-confirm-dialog-cancel>Cancel</button>
            <button type="button" class="danger-button" data-confirm-dialog-confirm>Continue</button>
        </div>
    </dialog>
    <script src="~/js/app-shell.js" asp-append-version="true" defer></script>
    <script src="~/js/confirmation-dialog.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
